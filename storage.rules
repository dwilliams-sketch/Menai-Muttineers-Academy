rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    function staff() { return signedIn() && (role() == 'trainer' || role() == 'admin' || role() == 'captain'); }
    function accountStaff() { return signedIn() && (role() == 'admin' || role() == 'captain'); }

    match /profiles/{uid}.jpg {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || accountStaff())
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /dogs/{dogId}.jpg {
      allow read: if signedIn();
      allow write: if signedIn()
        && (firestore.get(/databases/(default)/documents/dogs/$(dogId)).data.ownerId == request.auth.uid || accountStaff())
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
