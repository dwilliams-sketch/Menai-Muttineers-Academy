rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function accountStaff() {
      return signedIn()
        && (role() == 'admin' || role() == 'captain');
    }

    function trainingStaff() {
      return signedIn()
        && (
          role() == 'trainer'
          || role() == 'admin'
          || role() == 'captain'
        );
    }

    // Existing profile pictures
    match /profiles/{uid}/{fileName} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && fileName == 'profile.jpg'
        && (request.auth.uid == uid || accountStaff())
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if signedIn()
        && fileName == 'profile.jpg'
        && (request.auth.uid == uid || accountStaff());
    }

    // Existing dog pictures
    match /dogs/{dogId}/{fileName} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && fileName == 'profile.jpg'
        && (
          firestore.get(
            /databases/(default)/documents/dogs/$(dogId)
          ).data.ownerId == request.auth.uid
          || accountStaff()
        )
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if signedIn()
        && fileName == 'profile.jpg'
        && (
          firestore.get(
            /databases/(default)/documents/dogs/$(dogId)
          ).data.ownerId == request.auth.uid
          || accountStaff()
        );
    }

    // V1.4.2 learner assessment and Help Me videos.
    match /academyVideos/{uid}/{videoType}/{fileName} {

      // Learner sees their own footage.
      // Trainers, Captain and Admin can review submitted footage.
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || trainingStaff()
        );

      // Learners may only upload into their own folder.
      // Assessment/help are the only permitted video categories.
      // 100 MB is a hard safety ceiling; the app will target
      // much smaller compressed files.
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && (videoType == 'assessments' || videoType == 'help')
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      // Learner can remove their own unneeded upload.
      // Captain/Admin can remove footage during housekeeping.
      allow delete: if signedIn()
        && (
          request.auth.uid == uid
          || accountStaff()
        );
    }
  }
}
